{
  "version": "0.2.0",
  "configurations": [
    // Sobe a Api via Kestrel (JIT normal, breakpoint funciona igual a
    // qualquer projeto ASP.NET Core) — binda em http://localhost:5049
    // (e https://localhost:7236), lendo o perfil de
    // Properties/launchSettings.json (confirmado ao vivo via VS Code —
    // um teste anterior via `dotnet <dll>` puro no terminal, fora do VS
    // Code, tinha dado 5000, mas o VS Code lê launchSettings.json e usa
    // 5049 de verdade; corrigido depois de reproduzir o problema com o
    // usuário). Pré-requisito: LocalStack + cognito-local no ar
    // (`docker compose -f backend/infra/docker-compose.yml up -d`) —
    // appsettings.Development.json já aponta pra eles.
    {
      "name": "GastosApp.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/src/GastosApp.Api/bin/Debug/net10.0/GastosApp.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/GastosApp.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole",
      "stopAtEntry": false
    },
    // Debuga a suíte GastosApp.IntegrationTests (FEAT-29) via `dotnet
    // test` sob o debugger — o adaptador coreclr anexa automaticamente
    // no processo filho (testhost) que de fato roda a suíte, então
    // breakpoint em qualquer arquivo de tests/GastosApp.IntegrationTests
    // funciona normalmente. "justMyCode": false ajuda a inspecionar
    // dentro de FluentAssertions/SDK da AWS se precisar.
    //
    // Por padrão (sem env aqui, ou com INTEGRATION_TESTS_MODE=local
    // sozinha) a suíte aponta pra Api via Kestrel/JIT — precisa dela
    // rodando à parte (config "GastosApp.Api" acima, ou
    // `dotnet run --project src/GastosApp.Api`). É o padrão porque é o
    // caminho mais rápido pra iterar E o único onde dá pra colocar
    // breakpoint dentro do código da própria Api (não só do teste) —
    // ver README.md, "Debugar a própria Api". Pra validar contra o
    // binário Native AOT publicado de verdade, use
    // INTEGRATION_TESTS_TRANSPORT=rie (configs abaixo) — aí precisa do
    // container no ar via `./infra/lambda/local-env-up.sh`.
    {
      "name": "Debug Integration Tests (local via Kestrel, escolher filtro)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/backend/tests/GastosApp.IntegrationTests/GastosApp.IntegrationTests.csproj",
        "--filter", "${input:integrationTestFilter}"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "INTEGRATION_TESTS_MODE": "local"
      },
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": false
    },
    // Contra o container Native AOT via Runtime Interface Emulator (não
    // Kestrel) — precisa de INTEGRATION_TESTS_TRANSPORT=rie explícita
    // (esse é o modo "não-padrão" agora, ver comentário acima). Só
    // debuga o CÓDIGO DO TESTE (o container roda sem debugger anexado
    // — Native AOT não tem suporte de debug interativo equivalente ao
    // JIT). Pré-requisito: `./infra/lambda/local-env-up.sh`.
    {
      "name": "Debug Integration Tests (local via container/RIE, escolher filtro)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/backend/tests/GastosApp.IntegrationTests/GastosApp.IntegrationTests.csproj",
        "--filter", "${input:integrationTestFilter}"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "INTEGRATION_TESTS_MODE": "local",
        "INTEGRATION_TESTS_TRANSPORT": "rie"
      },
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": false
    },
    // Contra homologação real — precisa de `aws sso login` (ou
    // equivalente) já feito no terminal/perfil que o VS Code herda
    // ANTES de disparar esta config (credenciais resolvidas pela cadeia
    // padrão do SDK, não declaradas aqui). Cria/limpa uma conta de
    // teste real em hom.
    {
      "name": "Debug Integration Tests (hom, escolher filtro)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/backend/tests/GastosApp.IntegrationTests/GastosApp.IntegrationTests.csproj",
        "--filter", "${input:integrationTestFilter}"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "INTEGRATION_TESTS_MODE": "hom",
        "INTEGRATION_TESTS_BASE_URL": "https://api-hom.jrnexpenses.com",
        "INTEGRATION_TESTS_PARAMETER_STORE_PATH": "/GastosApp/Hom/"
      },
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "integrationTestFilter",
      "type": "promptString",
      "description": "Filtro do dotnet test (ex.: Category=Integration, ou FullyQualifiedName~NomeDoTeste)",
      "default": "Category=Integration"
    }
  ],
  "compounds": [
    // Sobe a Api (Kestrel/JIT) E dispara o teste integrado contra ela
    // numa tacada só — duas sessões de debug simultâneas no VS Code,
    // breakpoint funciona nas duas (código da Api E código do teste).
    // Pré-requisito: LocalStack + cognito-local no ar (ver comentário
    // na config "GastosApp.Api"). Risco de corrida: o compound não
    // espera a Api terminar de subir antes de disparar o teste — se a
    // primeira tentativa falhar por "connection refused", é só rodar
    // de novo só a config do teste (a Api já vai estar de pé). Se isso
    // incomodar, prefira o fluxo manual em 2 passos (README.md).
    {
      "name": "Debug Api + Integration Test (local via Kestrel)",
      "configurations": [
        "GastosApp.Api",
        "Debug Integration Tests (local via Kestrel, escolher filtro)"
      ],
      "stopAll": true
    }
  ]
}